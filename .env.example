# ==============================================================================
# Gravity Claw - Environment Configuration
# ==============================================================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID Whitelist (comma-separated list of numerical IDs)
# Only messages from these user IDs will be processed. All other users are silently ignored.
# To find your ID, message @userinfobot or @raw_data_bot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=123456789

# OpenRouter API Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Identifier
# Examples:
# - anthropic/claude-3.5-sonnet
# - anthropic/claude-3.7-sonnet
# - openai/gpt-4o
# - deepseek/deepseek-chat
# - meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Agent Configuration
# Maximum tool execution iterations per query before returning a response
MAX_AGENT_ITERATIONS=10

# Proactive Agent Heartbeat
# Interval in minutes between background wake-ups. 
HEARTBEAT_INTERVAL_MINUTES=60

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info
